---
/**
 * Header, footer and <head> for every page. The page fetches the brand (`site`)
 * and the visitor (`viewer`) with `pageContext` / `staticContext` and passes
 * them in, so the layout never makes an API call of its own.
 *
 * Sign in, joining and the community itself are App pages on this same
 * hostname: always plain `<a href>`, never a client-side route.
 */
import '../styles/global.css';

import BrandMark from '../components/BrandMark.astro';
import {FOOTER, LINKS, NAV} from '../content/site';
import type {Site, Viewer} from '../lib/types';
import {initials} from '../lib/format';
import {siteOrigin} from '../platform/api';

interface Props {
  site: Site | null;
  viewer: Viewer;
  /** The page's own name; the tab shows "<title> · <community>". Omit on home. */
  title?: string;
  description?: string;
  /** Social card image (absolute URL). */
  image?: string | null;
  /** Structured data (JSON-LD), one object or several. */
  jsonLd?: object | object[];
  /** Keep the page out of search engines. */
  noindex?: boolean;
  /**
   * A PRERENDERED page (`export const prerender = true`): built once, served
   * as a static file, so it knows no visitor. The header then renders the
   * signed-out view and the browser fills in the visitor (`/site-api/me`) and
   * a renamed community (`/site-api/site`) after load.
   */
  isStatic?: boolean;
}

const DEFAULT_IMAGE =
  'https://images.unsplash.com/photo-1544027993-37dbfe43562a?auto=format&fit=crop&w=1200&h=630&q=70';
const DEFAULT_DESCRIPTION =
  'An online school and community for developing Conflict Intelligence (CIQ) through the Seven Levels Framework: Space, Emotions, Identity, Relationships, Expression, Intuition and Spirituality.';

const {site, viewer, title, description, image, jsonLd, noindex = false, isStatic = false} = Astro.props;
const name = site?.name ?? 'Conflict Intelligence Community';
const fullTitle = title ? `${title} · ${name}` : name;
const metaDescription = description ?? DEFAULT_DESCRIPTION;
// Prerendered pages build as `/<page>/`: drop the trailing slash so the
// canonical matches the sitemap and the links between pages.
const path = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonical = new URL(path, siteOrigin(Astro.url)).href;
const ogImage = image ?? DEFAULT_IMAGE;
const active = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const groupActive = (items: {href: string}[]) => items.some(item => active(item.href));
// Back to this page after signing in. A PATH only: the App ignores full URLs.
const back = encodeURIComponent(`${path}${Astro.url.search}`);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// `<` escaped so no string inside the data can close the script tag.
const ldJson = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
const chevron =
  '<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title ?? name} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    {site?.favIcon && <link rel="icon" href={site.favIcon} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <link rel="preconnect" href="https://images.unsplash.com" />
    {ld.map(data => <script type="application/ld+json" set:html={ldJson(data)} />)}
  </head>
  <body data-viewer={viewer.state} data-static={isStatic ? '1' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="brand">
          <BrandMark site={site} />
          <span class="brand-name" data-brand-text="{name}" data-built-name={name}>{name}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            NAV.map(item =>
              item.children ? (
                <div class="nav-menu" data-menu>
                  <button
                    type="button"
                    aria-expanded="false"
                    aria-controls="menu-path"
                    class:list={{active: groupActive(item.children)}}>
                    {item.label}
                    <Fragment set:html={chevron} />
                  </button>
                  <div class="nav-panel" id="menu-path" hidden>
                    {item.children.map(child => (
                      <a href={child.href} aria-current={active(child.href) ? 'page' : undefined}>
                        {child.label}
                        {child.note && <span>{child.note}</span>}
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  class:list={{active: active(item.href)}}
                  aria-current={active(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              )
            )
          }
          <a
            href="/portal"
            class:list={{active: active('/portal')}}
            data-member-only
            hidden={viewer.state !== 'member'}>
            Dashboard
          </a>
        </nav>
        <div class="session" data-session>
          {
            viewer.state === 'member' ? (
              <>
                <a class="button ghost small-button" href={LINKS.community}>
                  Community
                </a>
                <span class="viewer" title={viewer.name ?? ''}>
                  {viewer.avatar ? (
                    <img src={viewer.avatar} alt="" width="28" height="28" />
                  ) : (
                    <span class="avatar-fallback" aria-hidden="true">
                      {initials(viewer.name ?? '')}
                    </span>
                  )}
                </span>
                {viewer.preview ? (
                  <span class="chip" title="Editor preview: a stand-in signed-in member">
                    Preview
                  </span>
                ) : (
                  <button class="button link small-button hide-sm" type="button" data-logout>
                    Sign out
                  </button>
                )}
              </>
            ) : viewer.state === 'applicant' ? (
              <a class="button small-button" href="/join">
                Finish joining
              </a>
            ) : (
              <>
                <a class="button link small-button hide-sm" href={`/login?redirectTo=${back}`}>
                  Log in
                </a>
                <a class="button small-button" href={LINKS.join}>
                  Join
                </a>
              </>
            )
          }
        </div>
        <button
          class="button ghost small-button icon menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
          data-mobile-toggle>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="mobile-panel" id="mobile-menu" hidden>
        <nav aria-label="Mobile">
          <div class="mobile-group">
            <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
            {
              NAV.filter(item => !item.children).map(item => (
                <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href="/portal" data-member-only hidden={viewer.state !== 'member'}>Dashboard</a>
          </div>
          {
            NAV.filter(item => item.children).map(item => (
              <div class="mobile-group">
                <p class="eyebrow">{item.label}</p>
                {item.children!.map(child => (
                  <a href={child.href} aria-current={active(child.href) ? 'page' : undefined}>
                    {child.label}
                  </a>
                ))}
              </div>
            ))
          }
          <div class="mobile-actions" data-guest-only hidden={viewer.state === 'member'}>
            <a class="button ghost" href={`/login?redirectTo=${back}`}>Log in</a>
            <a class="button" href={LINKS.join}>Join</a>
          </div>
        </nav>
      </div>
    </header>

    <div id="main" tabindex="-1"></div>
    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="brand">
              <BrandMark site={site} />
              <span class="brand-name" data-brand-text="{name}">{name}</span>
            </a>
            <p>EQ is to emotions as CIQ is to conflict. An online school and community for exploring conflict through the Seven Levels.</p>
          </div>
          {
            FOOTER.map(group => (
              <nav class="footer-col" aria-label={group.label}>
                <h2>{group.label}</h2>
                {group.items.map(item => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </nav>
            ))
          }
        </div>
        <div class="footer-bottom">
          <span data-brand-text="© {year} {name}">© {new Date().getUTCFullYear()} {name}</span>
          <nav class="footer-legal" aria-label="Legal">
            <a href="/legal/privacy">Privacy</a>
            <a href="/legal/terms">Terms</a>
            <a href="/legal/refunds-and-cancellations">Refunds and Cancellations</a>
            <a href="/legal/shipping">Shipping</a>
          </nav>
          <span>conflictintelligencetraining.com</span>
        </div>
      </div>
    </footer>

    <script>
      import {logout, refreshSession} from '../platform/browser';
      import {hydrateStaticPage} from '../platform/static-page';

      if (document.body.dataset.static === '1') void hydrateStaticPage();

      // The server saw an expired access token but a refresh cookie: refresh
      // ONCE in the browser (the server never does), then re-render signed in.
      if (document.body.dataset.viewer === 'returning') {
        const key = 'site:refreshed';
        let first = true;
        try {
          first = !sessionStorage.getItem(key);
          sessionStorage.setItem(key, '1');
        } catch {
          // Storage blocked: no way to remember the reload, so never reload
          // (it would repeat on every load). The visitor signs in again.
          first = false;
        }
        if (first) void refreshSession().then(ok => ok && window.location.reload());
      } else {
        try {
          sessionStorage.removeItem('site:refreshed');
        } catch {
          // Storage blocked: nothing to clear.
        }
      }

      // Every button shows when it is busy (AGENTS.md "Buttons and forms").
      const busy = (button: HTMLButtonElement, label?: string) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        if (label) button.textContent = label;
      };

      document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach(button =>
        button.addEventListener('click', () => {
          busy(button, 'Signing out…');
          void logout();
        })
      );

      // A search / filter form (GET) navigates: show its button busy until the next page.
      document.addEventListener('submit', event => {
        const form = event.target;
        if (event.defaultPrevented || !(form instanceof HTMLFormElement)) return;
        if (form.method.toLowerCase() !== 'get') return;
        if (event.submitter instanceof HTMLButtonElement) busy(event.submitter);
      });
      // Back/forward restores a page from memory: give its buttons back.
      window.addEventListener('pageshow', event => {
        if (!event.persisted) return;
        document.querySelectorAll<HTMLButtonElement>('button[aria-busy="true"]').forEach(button => {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        });
      });

      // Menus: the "Your path" dropdown and the phone menu. Escape or a click
      // elsewhere closes them; focus returns to the button that opened them.
      type Toggle = {button: HTMLButtonElement; panel: HTMLElement};
      const toggles: Toggle[] = [];
      const setOpen = ({button, panel}: Toggle, open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
        if (button.dataset.mobileToggle !== undefined) {
          button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        }
      };
      document
        .querySelectorAll<HTMLButtonElement>('[data-menu] > button, [data-mobile-toggle]')
        .forEach(button => {
          const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
          if (!panel) return;
          const toggle = {button, panel};
          toggles.push(toggle);
          button.addEventListener('click', () => {
            const open = button.getAttribute('aria-expanded') !== 'true';
            toggles.forEach(other => other !== toggle && setOpen(other, false));
            setOpen(toggle, open);
          });
        });
      document.addEventListener('click', event => {
        const target = event.target as Node;
        toggles.forEach(toggle => {
          if (!toggle.button.contains(target) && !toggle.panel.contains(target)) setOpen(toggle, false);
        });
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        toggles.forEach(toggle => {
          if (toggle.button.getAttribute('aria-expanded') === 'true') {
            setOpen(toggle, false);
            toggle.button.focus();
          }
        });
      });
    </script>
  </body>
</html>
