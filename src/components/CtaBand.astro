---
/** A closing invitation: a white card on the grey band, one primary action. */
interface Props {
  title: string;
  body?: string;
  href: string;
  label: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {title, body, href, label, secondaryHref, secondaryLabel} = Astro.props;
---

<section class="band band-canvas">
  <div class="wrap">
    <div class="cta-card">
      <div>
        <h2>{title}</h2>
        {body && <p class="muted">{body}</p>}
      </div>
      <div class="actions">
        {secondaryHref && <a class="button ghost" href={secondaryHref}>{secondaryLabel}</a>}
        <a class="button" href={href}>{label}</a>
      </div>
    </div>
  </div>
</section>
